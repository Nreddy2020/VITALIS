# VITALIS server configuration — copy this file to .env (which is already
# gitignored) or set these as real environment variables. Never commit a
# populated .env file.

# Required in any shared/staging/production environment. If unset, the
# server generates a random key at boot and prints it once to the console —
# fine for a solo local demo, not fine for anything another person can reach.
VITALIS_API_KEY=

# Comma-separated list of origins allowed to call the API from a browser.
# Leave empty to disable cross-origin calls entirely (same-origin only).
VITALIS_ALLOWED_ORIGINS=

# Ingestion request body cap, in bytes. Default: 2097152 (2MB).
VITALIS_MAX_BODY_BYTES=2097152

# Max requests per minute, per source IP, on the ingestion endpoints.
VITALIS_RATE_LIMIT_PER_MIN=300

# Where ingested traces are persisted to disk (Stage 0 file-backed
# persistence — Stage 1+ replaces this with a real database).
VITALIS_DATA_DIR=./data

PORT=4318

# Local evidence repository. See docs/34_Storage_Recovery_D2.md.
# Positive safe integers; configured bounds are not benchmarked production limits.
VITALIS_DURABLE_INGEST=true
VITALIS_MAX_TRACES=10000
VITALIS_MAX_SPANS=100000
VITALIS_MAX_TRACE_BYTES=33554432
VITALIS_MAX_JOURNAL_BYTES=16777216
VITALIS_MAX_STORAGE_BYTES=134217728
VITALIS_MAX_AUX_BYTES=8388608
VITALIS_MAX_AUX_RECORDS=10000
# Review horizon only. Evidence is held; automatic deletion is disabled.
VITALIS_RETENTION_MS=2592000000
