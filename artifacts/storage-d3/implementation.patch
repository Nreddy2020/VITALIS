+      // Hold a real OS-mediated SQLite writer lock. No PID guessing or lock-file deletion.
+      db = new DatabaseSync(path.join(this.directory, 'writer-lock.sqlite'), { timeout: 0 });
+      db.exec('BEGIN IMMEDIATE'); this.lock = db;
+    } catch (cause) {
+      if (db) db.close();
