{
  "id": "expo",
  "displayName": "Expo / React Native",
  "ecosystem": "npm",
  "_readme": "Compatibility knowledge as DATA. Adding a framework needs a file like this, not a code change. Every rule must carry a source; the loader refuses unsourced rules.",
  "sources": {
    "expoVersionTable": {
      "url": "https://docs.expo.dev/versions/latest/",
      "title": "Expo SDK reference — SDK / React Native / React / Node version table",
      "recordedAt": "2026-09-09"
    },
    "expoSdk53Changelog": {
      "url": "https://expo.dev/changelog/sdk-53",
      "title": "Expo SDK 53 changelog",
      "recordedAt": "2026-09-09"
    },
    "expoNewArchitecture": {
      "url": "https://docs.expo.dev/guides/new-architecture/",
      "title": "Expo — React Native New Architecture",
      "recordedAt": "2026-09-09"
    },
    "npmExpoRandom": {
      "url": "https://registry.npmjs.org/expo-random",
      "title": "npm registry metadata for expo-random (deprecated field)",
      "recordedAt": "2026-09-09"
    }
  },
  "facts": [
    {
      "name": "expo.newArchEnabled",
      "file": "app.json",
      "path": [
        "expo",
        "newArchEnabled"
      ]
    }
  ],
  "rules": [
    {
      "id": "expo-sdk-57-react-native",
      "description": "Expo SDK 57 targets react-native 0.86",
      "when": {
        "package": "expo",
        "constraint": {
          "op": "majorEquals",
          "value": 57
        }
      },
      "require": {
        "package": "react-native",
        "constraint": {
          "op": "minorMatch",
          "value": "0.86"
        }
      },
      "severity": "HIGH",
      "source": "expoVersionTable"
    },
    {
      "id": "expo-sdk-57-react",
      "description": "Expo SDK 57 targets react 19.2.3",
